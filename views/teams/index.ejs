<%- include('../partials/header') %>
<div class="page-header">
  <h1>Teams</h1>
  <a class="btn" href="/teams/new">Create Team</a>
</div>
<table>
  <thead>
    <tr><th>Name</th><th>Coach</th><th></th></tr>
  </thead>
  <tbody>
    <% teams.forEach(team => { %>
      <tr>
        <td><%= team.name %></td>
        <td><%= team.coach_name || 'TBD' %></td>
        <td><a class="link" href="/teams/<%= team.tm_id %>">View</a></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
