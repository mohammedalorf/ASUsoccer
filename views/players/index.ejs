<%- include('../partials/header') %>
<div class="page-header">
  <h1>Players</h1>
  <a class="btn" href="/players/new">Add Player</a>
</div>
<table>
  <thead>
    <tr><th>ASU ID</th><th>Name</th></tr>
  </thead>
  <tbody>
    <% players.forEach(p => { %>
      <tr>
        <td><%= p.asu_id %></td>
        <td><%= p.name %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
