<%- include('../partials/header') %>
<div class="page-header">
  <h1>Tournaments</h1>
  <a class="btn" href="/tournaments/new">Create Tournament</a>
</div>
<table>
  <thead>
    <tr><th>Name</th><th>Status</th><th>Dates</th><th>Rounds</th><th>Top Team</th><th></th></tr>
  </thead>
  <tbody>
    <% tournaments.forEach(t => { %>
      <tr>
        <td><a href="/tournaments/<%= t.tr_id %>"><%= t.name %></a></td>
        <td><%= t.status %></td>
        <td><%= t.start_date || '' %> - <%= t.end_date || '' %></td>
        <td><%= t.rounds || '-' %></td>
        <td><%= t.derived_winner || 'TBD' %></td>
        <td>
          <a class="link" href="/tournaments/<%= t.tr_id %>/edit">Edit</a>
          <form method="POST" action="/tournaments/<%= t.tr_id %>?_method=DELETE" class="inline">
            <button type="submit" class="link danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
