<%- include('../partials/header') %>
<div class="page-header">
  <h1>Matches</h1>
  <a class="btn" href="/matches/new">Create Match</a>
</div>
<table>
  <thead>
    <tr><th>Date</th><th>Score</th><th>Winner</th><th>Best Player</th></tr>
  </thead>
  <tbody>
    <% matches.forEach(m => { %>
      <tr>
        <td><a href="/matches/<%= m.match_id %>"><%= m.match_date || '' %></a></td>
        <td><%= m.score || 'TBD' %></td>
        <td><%= m.winner_name || 'Draw' %></td>
        <td><%= m.best_player_name || 'TBD' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
<%- include('../partials/footer') %>
